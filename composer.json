{
    "name": "adampatterson/axe",
    "description": "Axe parent theme",
    "type": "wordpress-theme",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Adam Patterson",
            "email": "hello@adampatterson.ca"
        }
    ],
    "keywords": [
        "WordPress",
        "theme"
    ],
    "support": {
        "issues": "https://github.com/adampatterson/Axe/issues",
        "source": "https://github.com/adampatterson/Axe"
    },
    "require": {
        "php": "^8.1, ^8.2",
        "adampatterson/axe-helpers": "dev-dev",
        "composer/installers": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Axe\\": "lib/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "require-dev": {
        "spatie/ray": "^1.47"
    }
}
